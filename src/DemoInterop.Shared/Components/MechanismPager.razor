@* Walking sideways through the mechanism pages in article order. Plain anchors rather than NavLink:
   the pager never points at the page it is standing on, so there is no active state to show. *@
<nav class="mech-pager" aria-label="Previous and next mechanism">
    @if (Mechanisms.Previous(Slug) is { } before)
    {
        <a class="mech-pager-link" href="@Mechanisms.Href(before)">
            <span class="mech-pager-where">previous</span>
            <span class="mech-pager-what">@before.DisplayNumber. @before.Label</span>
        </a>
    }
    else
    {
        <span class="mech-pager-link" aria-hidden="true"></span>
    }

    <a class="mech-pager-link mech-pager-middle" href="">
        <span class="mech-pager-where">overview</span>
        <span class="mech-pager-what">All mechanisms on one page</span>
    </a>

    @if (Mechanisms.Next(Slug) is { } after)
    {
        <a class="mech-pager-link mech-pager-next" href="@Mechanisms.Href(after)">
            <span class="mech-pager-where">next</span>
            <span class="mech-pager-what">@after.DisplayNumber. @after.Label</span>
        </a>
    }
    else
    {
        <span class="mech-pager-link mech-pager-next" aria-hidden="true"></span>
    }
</nav>

@code {
    /// <summary>The URL slug of the mechanism page hosting this pager.</summary>
    [Parameter, EditorRequired]
    public string Slug { get; set; } = "";
}

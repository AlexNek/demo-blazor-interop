@* The persistent site menu: grouped by article section, one entry per mechanism page. Both hosts
   drop this into their own sidebar, so the list of pages cannot exist on one host and be missing
   on the other — the overview link, the brand and the collapsing behaviour stay with the host,
   because that is the part each host already dresses its own way.

   Styled by .side-* rules in the shared demo.css, for the dark sidebar gradient both hosts use.
   Hrefs are relative — see Mechanisms.RoutePrefix. *@
<div class="side-menu">
    <p class="side-group">1. IJSRuntime</p>

    @foreach (var mechanism in Mechanisms.Section1)
    {
        <NavLink class="side-item" href="@Mechanisms.Href(mechanism)" Match="NavLinkMatch.All">
            <span class="side-num" aria-hidden="true">@mechanism.DisplayNumber</span>
            <span class="side-text">@mechanism.Label</span>
        </NavLink>
        @if (mechanism.WasmOnly)
        {
            <p class="side-note">Blazor WebAssembly only</p>
        }
    }

    <p class="side-group">2. Source generators</p>

    @foreach (var mechanism in Mechanisms.Section2.DistinctBy(e => e.Slug))
    {
        <NavLink class="side-item" href="@Mechanisms.Href(mechanism)" Match="NavLinkMatch.All">
            <span class="side-num" aria-hidden="true">@mechanism.DisplayNumber</span>
            <span class="side-text">@mechanism.Label</span>
        </NavLink>
        @if (mechanism.WasmOnly)
        {
            <p class="side-note">Blazor WebAssembly only</p>
        }
    }
</div>
